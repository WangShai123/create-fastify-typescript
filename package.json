  },
  "license": "ISC",
  "author": "Wang Shai <hiwangshai@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WangShai123/create-fastify-typescript.git"
  },
  "bin": {
    "create-fastify-typescript": "./bin/create.js"
  },
  "files": [
    ".env.example",
    "README.md",
    "README_zh.md",
    "app.ts",
    "bin",
    "config",
    "decorators",
    "dist",
    "package-lock.json",
    "package.json",
    "plugins",
    "routes",
    "scripts",
    "server.ts",
    "services",
    "templates",
    "tests",
    "tsconfig.json",
    "types",
    "utilities",
    "vite.config.ts"
  ],
  "type": "module",
  "main": "./dist/app.js",
  "exports": {
    ".": "./dist/app.js",
    "./app": "./dist/app.js",
    "./server": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean-dist.ts && tsc -p tsconfig.json && node scripts/copy-assets.ts",
    "check": "vp check",
    "dev": "node --watch server.ts",
    "start": "node dist/server.js",
    "test": "vp test"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
