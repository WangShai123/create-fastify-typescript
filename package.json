    "@fastify/rate-limit": "^11.2.0",
    "@fastify/redis": "^8.0.0",
    "@fastify/view": "^12.0.0",
    "bcrypt": "^6.0.0",
    "dayjs": "^1.11.21",
    "ejs": "^6.0.1",
    "fastify": "^5.10.0",
    "fastify-raw-body": "^5.0.0",
    "mysql2": "^3.23.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vite": "8.1.5",
    "vite-plus": "^0.2.6"
  },
  "engines": {
